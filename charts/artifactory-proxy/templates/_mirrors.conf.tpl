{{/*
mirrors.conf: upstream, maps and one server block per mirror.
Self-contained so it can be dropped into any nginx http{} include dir,
including the JFrog chart's bundled nginx.
*/}}
{{- define "ap.mirrorsConf" -}}
{{- $id := include "ap.ident" . -}}
{{- $u := urlParse (required "artifactory.url is required" .Values.artifactory.url) -}}
{{- $scheme := default "http" $u.scheme -}}
{{- $hostOnly := regexReplaceAll ":[0-9]+$" $u.host "" -}}
{{- $port := regexFind "[0-9]+$" (regexFind ":[0-9]+$" $u.host) | default (ternary "443" "80" (eq $scheme "https")) -}}
{{- $basePath := trimSuffix "/" $u.path -}}
{{- $hostHeader := default $u.host .Values.artifactory.hostHeader -}}
{{- $a := .Values.artifactory -}}
# Generated by Helm release {{ .Release.Name }} ({{ .Chart.Name }}-{{ .Chart.Version }}).
upstream {{ $id }}_artifactory {
    server {{ $hostOnly }}:{{ $port }};
    keepalive 32;
}

# Scheme the client used (TLS usually ends at the router/ingress).
map $http_x_forwarded_proto {{ "$" }}{{ $id }}_scheme {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# Point the Docker token realm back at the virtual host so clients never
# need to reach (or trust) Artifactory directly.
map $upstream_http_www_authenticate {{ "$" }}{{ $id }}_www_auth {
    "~^(?<{{ $id }}_rp>.*realm=\")[^\"]*(?<{{ $id }}_rs>\".*)$" "{{ "${" }}{{ $id }}_rp}{{ "$" }}{{ $id }}_scheme://$host/v2/token{{ "${" }}{{ $id }}_rs}";
    default $upstream_http_www_authenticate;
}
{{- range .Values.mirrors }}
{{- $type := default "docker" .type }}

# --- mirror: {{ .name }} ({{ $type }}) ---
server {
    listen {{ $.Values.nginx.httpPort }};
    {{- if and $.Values.nginx.enabled $.Values.nginx.tls.enabled }}
    listen 8443 ssl;
    {{- end }}
    server_name {{ join " " .hosts }};

    client_max_body_size 0;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_http_version 1.1;
    proxy_connect_timeout {{ $a.connectTimeout }};
    proxy_read_timeout {{ $a.readTimeout }};
    proxy_send_timeout {{ $a.readTimeout }};

    proxy_set_header Connection "";
    proxy_set_header Host "{{ $hostHeader }}";
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto {{ "$" }}{{ $id }}_scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    {{- if eq $scheme "https" }}
    proxy_ssl_server_name on;
    proxy_ssl_name {{ $hostOnly }};
    {{- if $a.tls.verify }}
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    {{- if $a.tls.caSecret }}
    proxy_ssl_trusted_certificate /etc/nginx/upstream-ca/ca.crt;
    {{- end }}
    {{- end }}
    {{- end }}
    {{- if eq $type "docker" }}
    {{- $api := printf "%s/artifactory/api/docker/%s/v2" $basePath .repository }}

    proxy_hide_header WWW-Authenticate;
    add_header WWW-Authenticate {{ "$" }}{{ $id }}_www_auth always;

    location = /v2/token {
        rewrite ^ {{ $api }}/token break;
        proxy_pass {{ $scheme }}://{{ $id }}_artifactory;
    }

    location /v2/ {
        rewrite ^/v2/(.*)$ {{ $api }}/$1 break;
        proxy_pass {{ $scheme }}://{{ $id }}_artifactory;
        proxy_redirect ~^(?:https?://[^/]+)?{{ $api }}/(.*)$ {{ "$" }}{{ $id }}_scheme://$host/v2/$1;
    }

    location / {
        default_type text/plain;
        return 404 "{{ .name }}: Docker registry mirror of {{ .repository }}; only /v2/ is served.\n";
    }
    {{- else }}
    {{- $prefix := printf "%s%s" $basePath (trimSuffix "/" (default "" .pathPrefix)) }}

    location / {
        {{- if $prefix }}
        rewrite ^(.*)$ {{ $prefix }}$1 break;
        {{- end }}
        proxy_pass {{ $scheme }}://{{ $id }}_artifactory;
        {{- if $prefix }}
        proxy_redirect ~^(?:https?://[^/]+)?{{ $prefix }}(/.*)?$ {{ "$" }}{{ $id }}_scheme://$host$1;
        {{- end }}
    }
    {{- end }}
    {{- with .extraConfig }}

{{ . | indent 4 }}
    {{- end }}
}
{{- end }}
{{ end }}
